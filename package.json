{
  "name": "yoto-icons-catalogue",
  "version": "1.0.0",
  "description": "Catalogue d'icônes 16×16 Yoto - Scraping, indexation et recherche cross-source",
  "main": "scripts/build-combined.js",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "scrape:yotopixels": "node scripts/yotopixels-scraper.js",
    "scrape:yotoicons": "node scripts/yotoicons-scraper.js",
    "scrape:yoto-official": "node scripts/yoto-official-scraper.js",
    "build:index": "node scripts/build-combined.js",
    "update:all": "pnpm run scrape:yotopixels && pnpm run scrape:yotoicons && pnpm run scrape:yoto-official && pnpm run build:index",
    "test": "node -e \"console.log('Test OK')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoto-community/icons-catalogue.git"
  },
  "keywords": [
    "yoto",
    "icons",
    "16x16",
    "scraping",
    "github-pages"
  ],
  "author": "Sylvain",
  "license": "MIT",
  "dependencies": {
    "lunr": "^2.3.9",
    "node-fetch": "^3.3.2",
    "cheerio": "^1.0.0-rc.12"
  }
}