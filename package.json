{
  "name": "yoto-icons-catalogue",
  "version": "1.0.0",
  "description": "Catalogue d'icônes 16×16 Yoto - Scraping, indexation et recherche cross-source",
  "private": true,
  "main": "scripts/build-api.js",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev:site": "pnpm --filter site dev",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:site": "pnpm --filter site build",
    "test:site": "pnpm --filter site test",
    "verify:site": "pnpm --filter site verify",
    "scrape:yotopixels": "node scripts/yotopixels-scraper.js",
    "scrape:yotoicons": "node scripts/yotoicons-scraper.js",
    "scrape:yoto-official": "node scripts/yoto-official-scraper.js",
    "build:api": "node scripts/build-api.js",
    "update:all": "pnpm run scrape:yotopixels && pnpm run scrape:yotoicons && pnpm run scrape:yoto-official && pnpm run build:api",
    "update:readme": "node scripts/update-readme-data.js",
    "check:readme": "node scripts/check-readme-data.js",
    "test": "node --test \"scripts/lib/*.test.js\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter './packages/*' build && changeset publish",
    "postinstall": "pnpm run build:packages"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoto-community/icons-catalogue.git"
  },
  "keywords": [
    "yoto",
    "icons",
    "16x16",
    "scraping",
    "github-pages"
  ],
  "author": "Sylvain",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "lunr": "^2.3.9",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25"
  }
}
