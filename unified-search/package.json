{
  "name": "yoto-icons-catalogue-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recherche unifiée d'icônes 16×16 Yoto — yotopixels + yotoicons",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-data",
    "copy-data": "cp public/combined-icons.json public/summary-combined.json dist/",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "esbuild"
    ]
  },
  "dependencies": {
    "lunr": "^2.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/lunr": "^2.3.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}