{
  "name": "yoto-icons-catalogue-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recherche unifiée d'icônes 16×16 Yoto — yotopixels + yotoicons + yoto-official",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-data",
    "copy-data": "cp public/icons.json public/summary.json dist/ && cp -r public/icons dist/",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run check:bundle"
  },
  "pnpm": {
    "allowedBuildScripts": [
      "esbuild"
    ]
  },
  "dependencies": {
    "lunr": "^2.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lunr": "^2.3.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
