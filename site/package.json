{
  "name": "yoto-icons-catalogue-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recherche unifiée d'icônes 16×16 Yoto — yotopixels + yotoicons + yoto-official",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-data.mjs && tsc && vite build && pnpm run copy-data && pnpm run postbuild && pnpm run generate:sitemap && pnpm run prerender",
    "check:data": "node scripts/check-data.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender-routes.mjs",
    "copy-data": "cp public/summary.json public/index.json dist/ && cp -r public/icons dist/ && cp -r public/icons-by-source dist/",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:spa": "node scripts/check-spa-fallback.mjs",
    "check:precache": "node scripts/check-precache.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "measure:search": "node scripts/measure-search-index.mjs",
    "verify": "pnpm run lint && pnpm run check && pnpm run check:i18n && pnpm run test && pnpm run build && pnpm run check:bundle && pnpm run check:spa && pnpm run check:precache && pnpm run check:seo"
  },
  "dependencies": {
    "lunr": "^2.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lunr": "^2.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
