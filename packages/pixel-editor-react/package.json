{
  "name": "@yoto-community/pixel-editor-react",
  "version": "0.1.1",
  "description": "Composant React accessible de l'éditeur d'icônes 16×16 Yoto.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoto-community/icons-catalogue.git",
    "directory": "packages/pixel-editor-react"
  },
  "keywords": [
    "yoto",
    "icons",
    "16x16",
    "pixel-editor",
    "pixel-art",
    "react"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@yoto-community/pixel-editor-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
